{
  "name": "proof-surface",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Proof Surface plugin scaffolded with elizaOS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --noCheck -p tsconfig.build.json && vite build --config vite.config.views.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src/ tests/",
    "test": "vitest run --config ./vitest.config.ts",
    "build:views": "vite build --config vite.config.views.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "assets",
    "dist"
  ],
  "dependencies": {
    "@elizaos/core": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^25.0.6",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vite": "^8.0.0"
  },
  "elizaos": {
    "plugin": {
      "displayName": "Proof Surface",
      "category": "utility"
    }
  }
}
